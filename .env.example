# Application
APP_ENV=development
SECRET_KEY=change-me-in-production

# Redis (Queue)
REDIS_URL=redis://redis:6379/0

# Whisper Model
# Options: tiny, base, small, medium, large
# Larger = more accurate but slower and requires more RAM
# tiny   ~1GB RAM  | fastest  | least accurate
# base   ~1GB RAM  | fast     | decent accuracy  ← recommended for dev
# small  ~2GB RAM  | moderate | good accuracy
# medium ~5GB RAM  | slow     | great accuracy
# large  ~10GB RAM | slowest  | best accuracy
WHISPER_MODEL=base

# Storage
MAX_FILE_SIZE_MB=100

# Worker retry config
MAX_RETRIES=3

# Supabase (Required)
# Get these from your Supabase project settings
SUPABASE_URL=https://<project-id>.supabase.co
SUPABASE_ANON_KEY=<your-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>
