# Application
APP_ENV=development
SECRET_KEY=change-me-in-production

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/transcription_db

# Redis (Queue)
REDIS_URL=redis://redis:6379/0

# Whisper Model
# Options: tiny, base, small, medium, large
# Larger = more accurate but slower and requires more RAM
# tiny   ~1GB RAM  | fastest  | least accurate
# base   ~1GB RAM  | fast     | decent accuracy  ← recommended for dev
# small  ~2GB RAM  | moderate | good accuracy
# medium ~5GB RAM  | slow     | great accuracy
# large  ~10GB RAM | slowest  | best accuracy
WHISPER_MODEL=base

# Storage
MAX_FILE_SIZE_MB=100

# Worker retry config
MAX_RETRIES=3
